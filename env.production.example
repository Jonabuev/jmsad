# Production Environment Variables
# Скопируйте этот файл в .env.production и заполните значения

# Django Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False

# Database Settings
DB_NAME=jmsad_db
DB_USER=jmsad_user
DB_PASSWORD=your-production-db-password
DB_HOST=postgres_prod
DB_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Settings
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=arno.help.service@gmail.com

# Production URLs
PRODUCTION_FRONTEND_URL=https://arno.kz
PRODUCTION_BACKEND_URL=https://api.arno.kz

# SSL Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Monitoring
SLACK_WEBHOOK_URL=your-slack-webhook-url
