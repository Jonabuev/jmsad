# ========================================
# Production-ready Django Backend Dockerfile
# ========================================
# Многоэтапная сборка для оптимизации размера

# ========================================
# Stage 1: Builder - устанавливаем зависимости
# ========================================
FROM python:3.12.6-slim as builder

# Устанавливаем системные зависимости для сборки
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libmariadb-dev \
    pkg-config \
    wget \
    curl \
    tesseract-ocr \
    tesseract-ocr-rus \
    tesseract-ocr-eng \
    tesseract-ocr-kaz \
    libtesseract-dev \
    poppler-utils \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем файл зависимостей
COPY req.txt .

# Устанавливаем Python зависимости
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r req.txt --extra-index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir gunicorn==21.2.0 gevent==24.2.1

# Проверяем установку Tesseract
RUN tesseract --version && \
    tesseract --list-langs && \
    echo "✅ Tesseract успешно установлен"

# ========================================
# Stage 2: Production - минимальный образ
# ========================================
FROM python:3.12.6-slim

# Метаданные
LABEL maintainer="admin@arno.kz"
LABEL description="JMSAD Backend Production"
LABEL version="1.0"

# Устанавливаем только runtime зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libmariadb3 \
    tesseract-ocr \
    tesseract-ocr-rus \
    tesseract-ocr-eng \
    tesseract-ocr-kaz \
    poppler-utils \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Копируем установленные пакеты из builder stage
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Копируем код приложения
COPY . .

# Создаем non-root пользователя для безопасности
RUN groupadd -r django && \
    useradd -r -g django -u 1000 django && \
    mkdir -p staticfiles media logs && \
    chown -R django:django /app

# Собираем статические файлы (может не работать без БД, игнорируем ошибки)
RUN python manage.py collectstatic --noinput --clear || echo "⚠️ Static files will be collected at runtime"

# Устанавливаем права на скрипты
RUN chmod +x scripts/*.sh 2>/dev/null || true

# Переключаемся на non-root пользователя
USER django

# Открываем порт
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Запускаем Gunicorn с оптимальными настройками
CMD ["gunicorn", "myproject.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--worker-class", "gevent", \
     "--worker-connections", "1000", \
     "--max-requests", "10000", \
     "--max-requests-jitter", "1000", \
     "--timeout", "120", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info", \
     "--capture-output"]


