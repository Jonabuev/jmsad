# Development образ с оптимизацией
FROM node:20-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей для лучшего кэширования
COPY package*.json ./

# Устанавливаем зависимости с кэшированием
# ⚠️ Временное решение: используем npm install вместо npm ci, так как package-lock.json не синхронизирован
# После обновления package-lock.json локально можно вернуть npm ci
RUN npm install --prefer-offline --no-audit --legacy-peer-deps

# Копируем исходный код
COPY . .

# Открываем порт 3000
EXPOSE 3000

# Запускаем приложение в режиме разработки
CMD ["npm", "run", "dev"] 