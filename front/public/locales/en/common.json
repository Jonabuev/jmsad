  "termsPolicy": {
    "title": "Terms and Policy",
    "section1": {
      "title": "1. Accuracy of Published Information",
      "description": "Each user is obligated to publish only truthful, verified information.",
      "prohibited": {
        "title": "What is prohibited:",
        "items": [
          "Deliberate distortion of facts, falsification of complaints or events.",
          "Posting complaints on behalf of third parties without their written consent.",
          "Using false documents or forged materials (screenshots, photos, contracts, etc.)."
        ]
      },
      "allowed": {
        "title": "What is allowed:",
        "items": [
          "Complaints supported by facts, contracts, photo/video evidence, correspondence.",
          "Posting reviews about personal experiences with the tenant."
        ]
      },
      "sanctions": {
        "title": "Sanctions:",
        "description": "Warning → 30-day account suspension → permanent ban for repeated violations. In case of severe violations — permanent ban."
      }
    },
    "section2": {
      "title": "2. Confidentiality and Protection of Personal Data",
      "prohibited": {
        "title": "What is prohibited:",
        "items": [
          "Disclosure of passport data, scans of identification documents, and other confidential data without justification.",
          "Posting data of third parties without their participation in the rental contract.",
          "Using user data for harassment, manipulation, or threats."
        ]
      },
      "allowed": {
        "title": "What is allowed:",
        "items": [
          "Indicating the full name, phone number, and ID number of the tenant within the complaint with the rental contract.",
          "Using edited documents without disclosing personal data."
        ]
      },
      "sanctions": {
        "title": "Sanctions:",
        "description": "Warning → Deletion of post → Temporary suspension → Possible data transfer to authorized authorities."
      }
    },
    "section3": {
      "title": "3. Respectful Communication and Ethics",
      "prohibited": {
        "title": "What is prohibited:",
        "items": ["Profanity, threats, bullying, and extortion."]
      },
      "allowed": {
        "title": "What is encouraged:",
        "items": ["Constructive criticism and objective presentation of facts."]
      },
      "sanctions": {
        "title": "Sanctions:",
        "description": "Warning → Temporary comment restriction → Account suspension."
      }
    },
    "section4": {
      "title": "4. Hate Speech and Discrimination",
      "description": "Racism, sexism, xenophobia, and other forms of intolerance are strictly prohibited.",
      "sanctions": {
        "title": "Sanctions:",
        "description": "Immediate account suspension without warning."
      }
    },
    "section5": {
      "title": "5. Prohibition of Advertising, Spam, and Self-Promotion",
      "prohibited": {
        "title": "What is prohibited:",
        "items": ["Advertising links, referral codes, spam."]
      },
      "allowed": {
        "title": "Exceptions:",
        "items": [
          "Recommendations from lawyers and partner organizations in special sections."
        ]
      },
      "sanctions": {
        "title": "Sanctions:",
        "description": "Post deletion → Temporary ban → Permanent ban."
      }
    },
    "section6": {
      "title": "6. Creation and Use of Fake Accounts",
      "description": "Creating multiple accounts for manipulation and using other people's data is prohibited.",
      "sanctions": {
        "title": "Sanctions:",
        "description": "Immediate ban of all associated accounts."
      }
    },
    "section7": {
      "title": "7. Using the Site for Illegal Purposes",
      "description": "Using the platform for extortion, threats, and falsifying evidence is prohibited.",
      "sanctions": {
        "title": "Sanctions:",
        "description": "Immediate ban and data transfer to law enforcement authorities."
      }
    },
    "section8": {
      "title": "8. Contesting Reviews and Complaints",
      "description": "Anyone can request a review of a complaint. Moderation is obligated to ensure the transparency of the review process."
    },
    "section9": {
      "title": "9. Respect for the Work of Administration and Moderation",
      "description": "Moderator decisions must be followed."
    },
    "section10": {
      "title": "10. Updating and Compliance with the Rules",
      "description": "Users automatically agree to the rules upon registration. Rules may be changed without notification."
    },
