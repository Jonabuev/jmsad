# Staging Environment Variables
# Скопируйте этот файл в .env.staging и заполните значения

# Django Settings
STAGING_SECRET_KEY=your-staging-secret-key-here
DEBUG=True

# Database Settings
DB_NAME=jmsad_staging_db
DB_USER=jmsad_staging_user
DB_PASSWORD=your-staging-db-password
DB_HOST=postgres_staging
DB_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Settings
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=arno.help.service@gmail.com

# Staging URLs
STAGING_FRONTEND_URL=http://localhost:3001
STAGING_BACKEND_URL=http://localhost:8001
