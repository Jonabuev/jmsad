# ✅ Оптимизированная конфигурация Nginx для JMSAD
# Использует кэширование, сжатие и оптимизацию статики

upstream backend {
    server backend:8000;
    keepalive 32;
}

upstream frontend {
    server frontend:3000;
    keepalive 32;
}

# Кэш для статических файлов
proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=static_cache:10m max_size=1g inactive=60m use_temp_path=off;

# Ограничение скорости запросов (защита от DDoS)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=general_limit:10m rate=30r/s;

server {
    listen 80;
    server_name arno.kz www.arno.kz;
    
    # Максимальный размер загружаемых файлов
    client_max_body_size 50M;
    
    # Таймауты
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    
    # Буферизация
    proxy_buffering on;
    proxy_buffer_size 4k;
    proxy_buffers 8 4k;
    proxy_busy_buffers_size 8k;

    # ✅ Сжатие (GZip)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types 
        text/plain 
        text/css 
        text/xml 
        text/javascript 
        application/json 
        application/javascript 
        application/xml+rss 
        application/rss+xml 
        font/truetype 
        font/opentype 
        application/vnd.ms-fontobject 
        image/svg+xml;
    gzip_disable "msie6";
    gzip_min_length 256;

    # ✅ Brotli сжатие (еще лучше чем GZip, если доступно)
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;

    # ========================================
    # СТАТИЧЕСКИЕ ФАЙЛЫ (Frontend)
    # ========================================
    location /_next/static/ {
        alias /app/front/.next/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        
        # Дополнительное сжатие
        gzip_static on;
    }

    # ========================================
    # МЕДИА ФАЙЛЫ (Backend)
    # ========================================
    location /media/ {
   	 alias /home/ubuntu/Jmsad/backend/media/;
        
        # ✅ Кэширование изображений на 30 дней
        expires 30d;
        add_header Cache-Control "public, immutable";
        
        # Отключаем логи для медиа (экономия ресурсов)
        access_log off;
        
        # Оптимизация для больших файлов
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        
        # Ограничение скорости загрузки (опционально)
        # limit_rate 1m;
    }

    # ========================================
    # СТАТИЧЕСКИЕ ФАЙЛЫ Django (Backend)
    # ========================================
    location /static/ {
	alias /home/ubuntu/Jmsad/backend/staticfiles/;
        
        # ✅ Кэширование на 1 год
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        
        # Дополнительное сжатие
        gzip_static on;
    }

    # ========================================
    # API (Backend Django)
    # ========================================
    location /api/ {
        # Ограничение скорости API запросов
        limit_req zone=api_limit burst=20 nodelay;
        
        proxy_pass http://backend;
        proxy_http_version 1.1;
        
        # Заголовки
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        
        # Отключаем кэширование для API
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        
        # CORS заголовки (если нужно)
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
        
        # Для OPTIONS запросов
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # ========================================
    # ADMIN ПАНЕЛЬ Django
    # ========================================
    location /django-admin/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Кэширование отключено для админки
        add_header Cache-Control "no-store";
    }

    # ========================================
    # HEALTH CHECK
    # ========================================
    location /health/ {
        proxy_pass http://backend;
        access_log off;
        add_header Cache-Control "no-cache";
    }

    # ========================================
    # FRONTEND (Next.js)
    # ========================================
    location / {
        limit_req zone=general_limit burst=50 nodelay;
        
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        
        # Заголовки
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # ✅ Кэширование HTML (опционально, для SSG страниц)
        proxy_cache static_cache;
        proxy_cache_valid 200 10m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        
        # Добавляем заголовок X-Cache-Status
        add_header X-Cache-Status $upstream_cache_status;
    }

    # ========================================
    # SECURITY HEADERS
    # ========================================
    
    # Защита от clickjacking
    add_header X-Frame-Options "SAMEORIGIN" always;
    
    # XSS защита
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Referrer Policy
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # HSTS (для HTTPS)
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}

